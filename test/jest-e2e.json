{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.[tj]s$": ["ts-jest", {
      "tsconfig": {
        "module": "commonjs",
        "moduleResolution": "node",
        "isolatedModules": false,
        "esModuleInterop": true
      }
    }]
  },
  "transformIgnorePatterns": ["/node_modules/(?!(?:@nestjs|rxjs)/)"]
}
